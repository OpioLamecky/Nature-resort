# ──────────────────────────────────────────────────────────────────────────────
#  Kalitusi Nature Resort — Environment Template
#
#  HOW TO USE:
#    Development (WAMP):  copy this to .env.local and fill in local values
#    Production (live):   copy this to .env and fill in production values
#
#  The system auto-detects:
#    .env.local exists  →  Development mode (debug ON, local DB, localhost URL)
#    .env.local absent  →  Production mode  (debug OFF, live DB, HTTPS URL)
# ──────────────────────────────────────────────────────────────────────────────

# "development" or "production"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Session cookie name (use different names for dev vs prod)
SESSION_NAME=kalitusi_sess

# SMTP Email settings
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME="Kalitusi Nature Resort"
